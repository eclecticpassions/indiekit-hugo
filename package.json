{
    "name": "hugo-indiekit",
    "version": "1.0.0",
    "description": "Indiekit server for https://burgeonlab.com",
    "main": "index.js",
    "scripts": {
        "start": "npx indiekit serve",
        "dev": "DEBUG=indiekit:*,@indiekit/store-gitea:* npx indiekit serve --port 8822"
