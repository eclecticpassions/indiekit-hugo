    "keywords": [
        "indiekit",
        "indieweb"
    ],
    "author": "",
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": ">=24.17.0"
    },
    "dependencies": {
        "@eclecticpassions/indiekit-preset-hugo": "^1.0.9",
        "@indiekit/endpoint-webmention-io": "^1.0.0-beta.28",
        "@indiekit/indiekit": "^1.0.0-beta.28",
        "@indiekit/post-type-event": "^1.0.0-beta.28",
        "@indiekit/post-type-rsvp": "^1.0.0-beta.28",
        "@indiekit/store-gitea": "^1.0.0-beta.28",
        "@indiekit/store-s3": "^1.0.0-beta.28",
        "@indiekit/syndicator-mastodon": "^1.0.0-beta.28",
        "sharp": "^0.34.5"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true,
        "bcrypt@6.0.0": true,
        "fsevents@2.3.3": true,
        "sharp@0.34.5": true,
        "esbuild@0.28.2": true
    }
